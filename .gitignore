# ==========================
# Root .gitignore for SQLoptimize (Python backend + Next.js frontend)
# ==========================

# --- OS / Editor ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# --- Node / Next.js (frontend) ---
node_modules/
.next/
.turbo/
out/
.vercel/
pnpm-lock.yaml
package-lock.json
yarn.lock
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python (backend) ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Test / Coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pytype/

# --- Environment files ---
.env
.env.*
!.env.example
!.env.local.example

# --- Logs / Temp ---
logs/
*.log
tmp/
temp/

# --- Misc ---
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.pnp.cjs
.pnp.loader.mjs
.pnp.js
.pnpm-store/

# --- Databases / Local data ---
*.db
*.sqlite
*.sqlite3
*.db-journal

# --- Python packaging / build metadata ---
pip-wheel-metadata/
*.whl
*.manifest
*.spec

# --- Python tools (Poetry / Pipenv) ---
poetry.lock
Pipfile
Pipfile.lock

# --- Local tooling / histories ---
.history/
.VSCodeCounter/

# --- Optional frontend build/test outputs ---
coverage/
storybook-static/

# --- C extensions (if any compiled locally) ---
*.so

# --- Local runtime logs ---
backend/*.log
frontend/*.log

# --- Misc cache ---
.ruff_cache/
.pytest_cache/

